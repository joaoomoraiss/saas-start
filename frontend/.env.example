# Copie para .env.local e preencha.

# ─── Backend (obrigatorio) ────────────────────────────────────────────────────
# URL da API NestJS, sem barra final. SERVER-SIDE: o browser nunca fala direto
# com a API, so com as rotas /api deste Next. Por isso nao e NEXT_PUBLIC_.
# No docker compose da raiz, vira http://backend:8080.
BACKEND_URL="http://localhost:8080"

# EXATAMENTE o mesmo JWT_SECRET do backend/.env. O proxy valida o access token
# localmente para liberar a navegacao sem ir a API em cada pagina.
# O JWT_REFRESH_SECRET NAO fica aqui: se um refresh token ainda vale quem
# decide e o banco, via backend.
JWT_SECRET=""

# EXATAMENTE o mesmo SERVICE_TOKEN do backend/.env. Identifica este servidor
# perante a API (rate limit por IP real, formulario de contato).
SERVICE_TOKEN=""

# ─── Site ─────────────────────────────────────────────────────────────────────
# Dominio publico. Alimenta metadataBase, canonical, sitemap.xml e robots.txt
# (libs/siteConfig.ts). Sem barra final.
NEXT_PUBLIC_DOMAIN_URL="http://localhost:3000"

# ─── Captcha: Cloudflare Turnstile (PREENCHER A MAO) ─────────────────────────
# Site key PUBLICA do widget. Par da TURNSTILE_SECRET_KEY do backend/.env —
# as duas precisam ser do MESMO widget. Passo a passo no README.
# Vazio = cadastro sem captcha (ok em dev, NAO em producao).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ─── Google Analytics (opcional) ─────────────────────────────────────────────
# Measurement ID (G-XXXXXXXXXX). So carrega depois do "Aceitar" no banner de
# cookies. Vazio = nenhum script do Google.
NEXT_PUBLIC_GA_ID=""
