# Copie para .env.local e preencha.

# URL base da API (NestJS). Sem barra final.
NEXT_PUBLIC_BACKEND_URL="http://localhost:8080"

# Domínio público do site. Alimenta metadataBase, canonical, sitemap.xml
# e robots.txt (libs/siteConfig.ts). Sem barra final.
NEXT_PUBLIC_DOMAIN_URL="http://localhost:3000"

# Precisa ser EXATAMENTE o JWT_REFRESH_SECRET do backend (nao o JWT_SECRET):
# o proxy.ts valida o cookie refreshToken localmente para proteger as rotas
# privadas, e o backend assina esse cookie com o secret de refresh.
# Server-side apenas: nunca prefixe com NEXT_PUBLIC_.
JWT_REFRESH_SECRET=""
