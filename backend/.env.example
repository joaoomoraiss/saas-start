# Copie para .env e preencha. O boot falha se algo obrigatorio estiver faltando.
# Gere cada secret com: openssl rand -hex 32
# (ou: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")

# --- Banco (obrigatorio) ---
# Combina com o docker-compose.yaml deste diretorio
DATABASE_URL="postgresql://root:root@localhost:5432/mydb?schema=public"

# --- JWT (obrigatorio) ---
# Minimo 32 caracteres e DIFERENTES entre si: cada tipo de token tem o seu, e
# um token de e-mail nunca pode ser aceito como token de acesso.
# JWT_SECRET tambem vai no frontend/.env.local, com o MESMO valor.
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_VERIFY_SECRET=""
JWT_FORGOT_SECRET=""

# --- Comunicacao Next -> API (obrigatorio) ---
# Segredo que identifica o servidor Next. Mesmo valor no frontend/.env.local.
# Minimo 32 caracteres, diferente dos JWT_*. Sem ele o rate limit conta todo
# o trafego como vindo de um IP so, e o formulario de contato responde 401.
SERVICE_TOKEN=""

# --- App (obrigatorio) ---
# Origem do frontend: base dos links de confirmacao/reset enviados por e-mail,
# do retorno do checkout e dos hostnames aceitos pelo captcha.
FRONTEND_URL="http://localhost:3000"

# --- Opcionais (valores abaixo sao os defaults) ---
NODE_ENV="development"
PORT="8080"

# Nome do produto nos e-mails.
APP_NAME="SaaS Start"

# Tempo de vida dos tokens
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# Exige e-mail confirmado para fazer login. Rotas que movimentam dinheiro
# exigem confirmacao sempre, independente deste flag.
REQUIRE_EMAIL_VERIFICATION="false"

# Quantos proxies reversos ficam na frente da API (ex.: "1" atras de nginx ou
# de um load balancer). Vazio = nenhum.
TRUST_PROXY=""

# Dominio do cookie de refresh, so para clientes que chamam a API direto (o
# frontend usa cookies proprios). Aplicado apenas com NODE_ENV=production.
COOKIE_DOMAIN=""

# =============================================================================
# PREENCHER A MAO — contas externas (passo a passo no README)
# =============================================================================

# --- E-mail: Resend (tudo ou nada entre RESEND_API_KEY e MAIL_FROM) ---
# Sem RESEND_API_KEY, em desenvolvimento os e-mails NAO sao enviados e os links
# de confirmacao/reset aparecem no log do backend. Em producao o envio falha.
#
# API key em https://resend.com/api-keys (comeca com re_)
RESEND_API_KEY=""
# Remetente num dominio verificado no Resend, ex: "Acme <no-reply@acme.com>"
MAIL_FROM=""
# Caixa que recebe o formulario de contato do site. Vazio = formulario em 503.
CONTACT_EMAIL=""

# --- Captcha: Cloudflare Turnstile ---
# Secret key do widget (par da NEXT_PUBLIC_TURNSTILE_SITE_KEY do frontend —
# as duas do MESMO widget). Vazio = cadastro sem captcha (NAO use em producao).
TURNSTILE_SECRET_KEY=""

# --- Stripe (opcional: tudo ou nada) ---
# Deixe TODAS vazias para rodar sem pagamentos: o modulo sobe e as rotas
# /payments respondem 503. Preencher so uma parte quebra o boot de proposito
# — meia configuracao aceita checkout e nunca libera o plano.
# Chave de teste (sk_test_) fora de producao; live (sk_live_) so com
# NODE_ENV=production. Misturar quebra o boot.
#
# Chaves em https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
# Gerado por `stripe listen --forward-to localhost:8080/payments/webhook`
STRIPE_WEBHOOK_SECRET=""
# Um Price ID por plano pago (Products > seu produto > Pricing).
# Os nomes das chaves vem de PLAN_CONFIG em src/payments/plan.config.ts.
STRIPE_PRICE_ID_STANDARD=""
STRIPE_PRICE_ID_PRO=""
