# Copie para .env e preencha. O boot falha se algo obrigatorio estiver faltando.
# Gere cada secret com: openssl rand -hex 32

# --- Banco (obrigatorio) ---
# Combina com o docker-compose.yaml deste repositorio
DATABASE_URL="postgresql://root:root@localhost:5432/mydb?schema=public"

# --- JWT (obrigatorio) ---
# Precisam ter no minimo 32 caracteres e ser DIFERENTES entre si.
# Cada tipo de token tem seu proprio secret: um token de e-mail nunca
# pode ser aceito como token de acesso.
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_VERIFY_SECRET=""
JWT_FORGOT_SECRET=""

# --- App (obrigatorio) ---
# Origem do frontend: usada no CORS e nos links de confirmacao/reset
# enviados por e-mail. Precisa bater com onde o Next esta servindo.
FRONTEND_URL="http://localhost:3000"

# --- Opcionais (valores abaixo sao os defaults) ---
NODE_ENV="development"
PORT="8080"

# Tempo de vida dos tokens
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# Exige e-mail confirmado para fazer login.
# Deixe false em desenvolvimento se ainda nao configurou SMTP.
REQUIRE_EMAIL_VERIFICATION="false"

# Dominio do cookie de refresh. So e aplicado quando NODE_ENV=production.
# Use o dominio compartilhado entre API e frontend, ex: ".seudominio.com"
COOKIE_DOMAIN=""

# --- SMTP ---
# Sem isso o envio de e-mail falha (confirmacao e reset de senha).
# No Gmail, use uma "App Password", nao a senha da conta.
EMAIL_USER=""
EMAIL_PASS=""

# --- Stripe (opcional: tudo ou nada) ---
# Deixe TODAS vazias para rodar sem pagamentos: o modulo sobe e as rotas
# /payments respondem 503. Preencher so uma parte quebra o boot de proposito
# — meia configuracao aceita checkout e nunca libera o plano.
#
# Chaves em https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
# Gerado por `stripe listen --forward-to localhost:8080/payments/webhook`
STRIPE_WEBHOOK_SECRET=""
# Um Price ID por plano pago (Products > seu produto > Pricing).
# Os nomes das chaves vem de PLAN_CONFIG em src/payments/plan.config.ts.
STRIPE_PRICE_ID_STANDARD=""
STRIPE_PRICE_ID_PRO=""
