// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

/// Planos da assinatura. FREE e o default e nao passa por checkout.
/// Ao renomear/adicionar, atualize PLAN_CONFIG (src/payments/plan.config.ts)
/// e o array PLANS do frontend (components/pricing).
enum Plan {
  FREE
  STANDARD
  PRO
}

enum PaymentStatus {
  PAID
  FAILED
  REFUNDED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(USER)
  isVerified Boolean @default(false)

  // --- Billing ---------------------------------------------------------
  // Estado ATUAL da assinatura. O historico fica em Payment.
  plan               Plan    @default(FREE)
  credits            Int     @default(0)
  /// Espelho do status da Stripe: "active" | "past_due" | "canceled" | null.
  subscriptionStatus String?
  /// Unique porque dois usuarios compartilhando o mesmo cliente/assinatura
  /// corromperia o roteamento dos webhooks (que so trazem IDs da Stripe).
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  /// Ultima Checkout Session criada. Permite expirar a sessao anterior antes
  /// de abrir outra: sem isso, duas abas de checkout viram duas assinaturas.
  stripeCheckoutSessionId String?

  payments      Payment[]
  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Por que uma sessao deixou de valer. Separar os motivos e o que permite
/// distinguir roubo de token (reuso de um token ROTATED) de um evento benigno
/// (logout, troca de senha).
enum RevokedReason {
  ROTATED
  LOGOUT
  PASSWORD_CHANGE
  REUSE
}

/// Uma linha por sessao (refresh token emitido). Guarda so o SHA-256 do
/// token: um dump do banco nao entrega sessoes validas.
model RefreshToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique
  expiresAt DateTime

  revokedAt     DateTime?
  revokedReason RevokedReason?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Tokens de uso unico ja consumidos (hoje: reset de senha), pelo `jti`.
/// A linha so precisa existir ate o JWT expirar; o job de limpeza apaga.
model UsedToken {
  jti       String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

/// Historico de cobrancas: uma linha por fatura. Append-only, escrito
/// exclusivamente pelo webhook da Stripe — nunca por acao do usuario.
model Payment {
  id     String  @id @default(uuid())
  /// SET NULL, nao CASCADE: registro fiscal precisa sobreviver a exclusao da
  /// conta (a LGPD, Art. 16, I, preserva essa obrigacao legal). Apagar a conta
  /// desfaz o vinculo com a pessoa; a cobranca continua no historico.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Plano no MOMENTO da cobranca — congelado, nao segue mudancas futuras.
  plan     Plan
  /// Em CENTAVOS (a Stripe trabalha na menor unidade monetaria). Nunca float.
  amount   Int
  currency String
  status   PaymentStatus @default(PAID)

  /// Chave de idempotencia: e o unique daqui que impede a reentrega de um
  /// evento pela Stripe de duplicar a fatura.
  stripeInvoiceId      String  @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?

  /// Guardados para nao ter que chamar a API da Stripe toda vez que o
  /// usuario abre a tela de faturas.
  hostedInvoiceUrl String?
  invoicePdfUrl    String?

  paidAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum Buttons {
  COMMON
  BUY
}

model Email {
  id      String  @id @default(uuid())
  address String  @unique
  button  Buttons @default(COMMON)
}
